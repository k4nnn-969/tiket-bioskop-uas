generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cinema {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  brand          String     @default("XXI") 
  city           String
  address        String
  phone          String
  operatingHours String     @default("10:00 - 23:45 WIB")
  facilities     String   
  studioTypes    String
  totalStudios   Int        @default(6)
  ticketBaseInfo String
  mapUrl         String?
  showtimes      Showtime[]
  createdAt      DateTime   @default(now())

  @@index([city])
}

model Movie {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  genre       String
  durationMin Int
  rating      String
  synopsis    String
  posterUrl   String
  status      String     @default("NOW_SHOWING")  
  releaseDate String
  showtimes   Showtime[]
}

model Showtime {
  id          String       @id @default(cuid())
  movieTitle  String
  rating      String
  cinema      String
  studio      String
  showDate    String
  showTime    String
  ticketPrice Int
  adminFee    Int          @default(4000)
  studioType  String       @default("REGULAR")
  totalSeats  Int          @default(96)
  cinemaId    String?
  movieId     String?
  cinemaRel   Cinema?      @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  movieRel    Movie?       @relation(fields: [movieId], references: [id], onDelete: Cascade)

  bookings    Booking[]
  bookedSeats BookedSeat[]

  @@index([cinemaId, showDate])
  @@index([movieId, showDate])
}

model Booking {
  id            String       @id @default(cuid())
  bookingCode   String       @unique
  showtimeId    String
  paymentMethod String
  totalAmount   Int
  status        String       @default("PAID")
  createdAt     DateTime     @default(now())
  showtime      Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  bookedSeats   BookedSeat[]
}

model BookedSeat {
  id         String   @id @default(cuid())
  seatNumber String
  showtimeId String
  bookingId  String
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatNumber])
}